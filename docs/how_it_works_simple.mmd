%%{init: {"flowchart": {"nodeSpacing": 50, "rankSpacing": 50, "curve": "basis", "padding": 20}}}%%
flowchart TB
    subgraph S1["PART 1 · SENSE"]
        direction LR
        B["<b>1. Watch</b><br/>Wi-Fi signal<br/>4× per second"] --> C["<b>2. Clean</b><br/>remove jumps,<br/>smooth"] --> D["<b>3. Predict</b><br/>falling?<br/>seconds left?"] --> E{"<b>4.</b> About<br/>to fail?"}
    end

    subgraph S2["PART 2 · DECIDE"]
        direction LR
        F["<b>5. Choose</b><br/>score the other<br/>access points"] --> G{"<b>6.</b> 8 dB<br/>better?"} --> H{"<b>7.</b><br/>Safe?"}
    end

    subgraph S3["PART 3 · ACT AND REMEMBER"]
        direction LR
        I["<b>8. Switch</b><br/>Windows connects<br/>to the better AP"] --> J{"<b>9.</b> Internet<br/>OK?"}
        J -- "Yes" --> K["<b>Success</b><br/>wait 20 s"]
        J -- "No" --> L["<b>Give back</b><br/>to Windows"]
        K --> M[("<b>10. Remember</b><br/>database + log")]
        L --> M
    end

    W(["<b>Keep watching</b><br/>back to step 1"])

    S1 -- "Yes" --> S2
    S2 -- "Yes" --> S3
    S1 -. "No" .-> W
    S2 -. "No" .-> W
    S3 -. "done" .-> W

    classDef step fill:#eef4ff,stroke:#3b6fd8,stroke-width:2px,color:#111,font-size:22px
    classDef ask fill:#fff6e0,stroke:#d49a00,stroke-width:2px,color:#111,font-size:22px
    classDef good fill:#e6f6ea,stroke:#2e8b47,stroke-width:2px,color:#111,font-size:22px
    classDef bad fill:#fdecea,stroke:#c0392b,stroke-width:2px,color:#111,font-size:22px
    classDef idle fill:#ffffff,stroke:#555,stroke-width:2px,color:#111,font-size:22px
    class B,C,D,F,I,M step
    class E,G,H,J ask
    class K good
    class L bad
    class W idle
    style S1 fill:#fafafa,stroke:#999
    style S2 fill:#fafafa,stroke:#999
    style S3 fill:#fafafa,stroke:#999
